{
  "name": "the-money-map",
  "version": "0.3.0",
  "private": true,
  "description": "Navigate Your Journey to Financial Freedom. Markdown-sourced personal finance education platform.",
  "scripts": {
    "dev": "velite --watch & next dev",
    "build": "velite && next build",
    "start": "next start",
    "generate": "velite && node scripts/build-search-index.mjs",
    "generate:search": "node scripts/build-search-index.mjs",
    "pdf": "npm run generate && node scripts/build-guide-pdf.mjs && node scripts/build-ebook-pdf.mjs",
    "pdf:guide": "node scripts/build-guide-pdf.mjs",
    "pdf:ebook": "node scripts/build-ebook-pdf.mjs",
    "audit:provenance": "node scripts/audit-provenance.mjs",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc.tsbuildinfo",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "framer-motion": "^12.42.2",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.25.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "velite": "^0.4.0",
    "typescript": "^5.9.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.6"
  }
}
